# config.local.yaml — 本地私密配置模板
# 复制此文件为 config.local.yaml 并填入真实值
# config.local.yaml 已在 .gitignore 中，不会被 git 追踪
#
# 此文件中的配置会深度合并覆盖 config.yaml 中的同名键
# 环境变量 ARXIV_AGENT__ 前缀的变量优先级最高

# AI 评分过滤 — 敏感配置
ai_filter:
  # OpenAI 兼容 API 的密钥（必填）
  api_key: "your-api-key-here"
  # 示例：
  #   Ollama 本地: 留空 ""
  #   OpenAI: "sk-xxxxx"
  #   其他兼容 API: "your-key"
